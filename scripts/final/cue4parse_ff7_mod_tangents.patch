diff --git a/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshVertexBuffer.cs b/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshVertexBuffer.cs
index 3d885d7..c93e5c6 100644
--- a/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshVertexBuffer.cs
+++ b/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshVertexBuffer.cs
@@ -45,10 +45,21 @@ public FStaticMeshVertexBuffer(FArchive Ar)
                 if (Ar.Game is GAME_StarWarsJediFallenOrder or GAME_StarWarsJediSurvivor && Ar.ReadBoolean()) // bDropNormals
                     goto texture_coordinates;
 
+                // FF7 Rebirth ships 4-byte packed tangents, but mod meshes cooked by the stock UE 4.26
+                // editor keep the usual 8/16-byte UE4 tangents: peek at the bulk element size and let
+                // those fall through to the generic reader below.
+                var ff7PackedTangents = false;
+                if (Ar.Game == GAME_FinalFantasy7Rebirth)
+                {
+                    var peek = Ar.Position;
+                    ff7PackedTangents = Ar.Read<int>() == 4;
+                    Ar.Position = peek;
+                }
+
                 var customTangents = Ar.Game switch
                 {
                     GAME_HonorofKingsWorld => Ar.ReadBulkArray(() => FStaticMeshUVItem.SerializeHonorOfKingsWorldQTangent(Ar, UseHighPrecisionTangentBasis)),
-                    GAME_FinalFantasy7Rebirth => Ar.ReadBulkArray(() => FStaticMeshUVItem.SerializeTangentsFF7R(Ar)),
+                    GAME_FinalFantasy7Rebirth when ff7PackedTangents => Ar.ReadBulkArray(() => FStaticMeshUVItem.SerializeTangentsFF7R(Ar)),
                     GAME_GangstarMirageCity => FStaticMeshUVItem.SerializeTangentsGangstar(Ar),
                     _ => null,
                 };
